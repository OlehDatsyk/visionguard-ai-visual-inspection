# VisionGuard AI configuration. Copy to .env, or let the startup script create it.
# Placeholder values only. Never commit a real .env.
#
# Only SECRET_KEY is mandatory, and only in production. Every other value has a working default.

# --- Application ---------------------------------------------------------------------------------
# development | test | production. Production refuses weak secrets and wildcard CORS, and hides /docs.
ENVIRONMENT=development
LOG_LEVEL=INFO
# Leave unset to enable API docs everywhere except production.
# ENABLE_DOCS=false

# --- Local ports (startup script only) -----------------------------------------------------------
BACKEND_PORT=8010
FRONTEND_PORT=5173

# --- Authentication ------------------------------------------------------------------------------
# MANDATORY in production: at least 32 random characters.
SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_TTL_MINUTES=720

# --- Database ------------------------------------------------------------------------------------
# Empty uses SQLite at storage/visionguard.db. PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/visionguard
DATABASE_URL=

# --- Browser access ------------------------------------------------------------------------------
# Comma-separated frontend origins allowed to call the API. A wildcard is refused in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- File storage --------------------------------------------------------------------------------
# local | s3
STORAGE_BACKEND=local
# Empty uses ./storage. Must be an absolute path on a persistent disk in production.
STORAGE_ROOT=
# false shows users a warning that files may disappear on restart.
STORAGE_PERSISTENT=true
# Only for STORAGE_BACKEND=s3. Also run: pip install -r backend/requirements-s3.txt
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Upload limits -------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=20
MAX_FILES_PER_UPLOAD=20
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_DIMENSION=12000
MIN_IMAGE_DIMENSION=32

# --- Computer vision -----------------------------------------------------------------------------
# Empty uses backend/model_weights. Detection shows as unavailable if the weights are missing.
MODEL_DIR=
DETECTOR_INPUT_SIZE=416
DETECTOR_CONFIDENCE_THRESHOLD=0.25
ONNX_THREADS=2

# --- Background jobs -----------------------------------------------------------------------------
# true runs the worker inside the API process. false needs: python -m app.worker
RUN_WORKER_IN_API=true
WORKER_POLL_SECONDS=1
JOB_MAX_ATTEMPTS=2
JOB_STALE_AFTER_SECONDS=600

# --- Optional external AI ------------------------------------------------------------------------
# none | anthropic. "none" answers from stored records, with no external service.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=45
AI_DAILY_MESSAGE_LIMIT=50

# --- Rate limits (per minute) --------------------------------------------------------------------
AUTH_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_MINUTE=30
ASSISTANT_RATE_LIMIT_PER_MINUTE=20
